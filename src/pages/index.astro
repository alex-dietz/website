---
import '../styles/global.css';
import { site, sections } from '../data/site';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={`https://${site.domain}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={`https://${site.domain}/`} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <main class="page">
      <header class="header">
        <h1 class="name">{site.name}</h1>
        <p class="intro">{site.intro}</p>
      </header>

      {
        sections.map((section) => (
          <section class="section">
            <h2 class="section__label">{section.label}</h2>
            <ul class={`section__items${section.items.every((i) => !i.description) ? ' section__items--inline' : ''}`}>
              {section.items.map((item) => (
                <li class="item">
                  <a class="item__link" href={item.href} target="_blank" rel="noopener noreferrer me">{item.name}</a>
                  {item.meta && <span class="item__meta">{item.meta}</span>}
                  {item.description && <p class="item__description">{item.description}</p>}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </main>
  </body>
</html>
