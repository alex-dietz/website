---
/**
 * The rule under the name. Looks like punctuation, behaves like a slider —
 * drag it (or arrow-key it) far enough either way and the page changes
 * typographic era. Releases spring back to centre.
 */
---

<div
  class="rule"
  id="rule"
  role="slider"
  tabindex="0"
  aria-label="Typographic era"
  aria-valuemin="-1"
  aria-valuemax="1"
  aria-valuenow="0"
  aria-valuetext="present day"
></div>
